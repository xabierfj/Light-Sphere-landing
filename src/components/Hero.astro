---
---

<section id="hero" aria-labelledby="hero-title" class="pt-5 pb-10 sm:pt-7 sm:pb-14">
	<div class="wrap">
		<div class="frame crop crop-lg grid gap-1.5 lg:min-h-[min(46rem,calc(100svh-7.5rem))] lg:grid-cols-2">
			<!-- Left panel: the claim. -->
			<div class="flex flex-col border border-line bg-panel/70">
				<div class="film mx-5 mt-5 sm:mx-8" aria-hidden="true"></div>

				<div class="flex flex-1 flex-col justify-center py-10 sm:py-14">
					<div class="border-y border-line bg-linear-to-r from-sheet via-sheet/90 to-panel px-5 py-6 sm:px-8 sm:py-8">
						<h1 id="hero-title" class="font-display text-[clamp(2.4rem,5.4vw,4.6rem)] leading-[1.02] font-extralight tracking-[-0.04em]">
							Solo una persona
							<span class="serif text-[1.12em]">
								tendrá <span class="ink-fade">color.</span>
							</span>
						</h1>
					</div>
					<div class="flex flex-col gap-7 px-5 pt-7 sm:px-8">
						<p class="m-0 max-w-[50ch] text-[1.0625rem] text-graphite">
							<strong class="font-semibold text-ink">TRUE COLORS</strong> es un microimplante experimental para un solo ojo. Tu vista sigue igual hasta que ves a la persona que,
							según creemos, estás destinado a querer más. Entonces la ves rodeada de un aura de color que solo tú percibes.
						</p>
						<div class="flex flex-wrap items-center gap-x-6 gap-y-5">
							<a href="#beta" class="btn btn-primary crop max-sm:w-full">
								Únete a la beta
							</a>
							<a href="#implante" class="btn btn-quiet crop max-sm:w-full">
								Cómo funciona
							</a>
						</div>
						<p class="note m-0 max-w-[52ch]">
							Beta gratis hasta el 20 de septiembre de 2033 solo para quienes ya están en nuestra lista de clientes habituales. Los demás pueden comprarlo cuando sea posible.
						</p>
					</div>
				</div>

				<dl class="m-0 grid grid-cols-3 border-t border-line font-labels text-[0.6875rem] leading-snug">
					<div class="border-r border-line px-4 py-3 sm:px-8">
						<dt class="text-faint">Visible</dt>
						<dd class="m-0 text-ink">Solo para ti</dd>
					</div>
					<div class="border-r border-line px-4 py-3 sm:px-6">
						<dt class="text-faint">Color</dt>
						<dd class="m-0 text-ink">Fijo, personal</dd>
					</div>
					<div class="px-4 py-3 sm:px-6">
						<dt class="text-faint">Significado</dt>
						<dd class="m-0 text-ink">En estudio</dd>
					</div>
				</dl>
			</div>

			<!-- Right panel: the instrument drawing. -->
			<figure class="relative m-0 grid min-h-88 place-items-center overflow-hidden border border-line bg-sheet p-6 sm:min-h-128">
				<img src="/images/truecolor_eye.webp" alt="" class="absolute inset-0 h-full w-full object-contain" />
				<figcaption class="contents">
					<span class="chip absolute top-4 left-4"><b>ID</b> TC-2033-0920</span>
					<span class="chip absolute top-4 right-4 max-sm:hidden">ESCALA 12:1</span>
					<span class="chip absolute top-[22%] left-4 max-md:hidden">LENTE · <b>1 ojo</b></span>
					<span class="chip absolute right-4 bottom-[16%] max-md:hidden">AURA · <b>solo la ve el portador</b></span>
					<span class="chip absolute bottom-4 left-4">AZUL · NARANJA <b>en estudio</b></span>
					<span class="chip absolute right-4 bottom-4 max-sm:hidden">FIG. 01</span>
				</figcaption>
			</figure>
		</div>
	</div>
</section>
