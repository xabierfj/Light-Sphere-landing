---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Página no encontrada · LightSphere Optics" description="La página que buscas no existe o ha cambiado de sitio." noindex>
	<a href="#contenido" class="sr-only z-60 bg-ink px-4 py-2 font-labels text-xs text-paper uppercase focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
		Saltar al contenido
	</a>
	<Nav />
	<main id="contenido" class="section-y">
		<div class="wrap">
			<div class="frame crop crop-lg">
				<section class="border border-line bg-sheet">
					<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-line px-6 py-3 sm:px-10">
						<span class="font-labels text-xs whitespace-nowrap text-graphite">LS / ERROR-404</span>
						<span class="font-labels text-xs text-faint">Sin señal</span>
					</div>
					<div class="bg-linear-to-r from-sheet via-sheet/90 to-panel px-6 py-14 sm:px-10 sm:py-20">
						<p class="chip mb-4">404</p>
						<h1 class="heading-section m-0">Aquí no hay nada que ver</h1>
						<p class="mt-4 max-w-[56ch] text-graphite">
							La página que buscas no existe o ha cambiado de sitio. Puede que el enlace esté roto, o que nunca llegara a existir.
						</p>
					</div>
				</section>
			</div>
			<a href="/" class="btn btn-primary crop mt-10">Volver a la página principal</a>
		</div>
	</main>
	<Footer />
</Layout>
