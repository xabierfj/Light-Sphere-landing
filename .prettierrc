{
	"singleQuote": true,
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 180,
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/styles/global.css",
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": "*.json",
			"options": {
				"useTabs": false
			}
		}
	]
}
